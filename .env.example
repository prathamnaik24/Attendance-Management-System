# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# When running WITHOUT Docker (local dev):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# When running WITH Docker:
# DB_HOST is overridden automatically to "postgres" (the service name) by docker-compose.yml
# You do NOT need to change DB_HOST manually when using Docker.

# Full connection string (alternative to individual vars above)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/attendance_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── QR Token ─────────────────────────────────────────────────────────────────
QR_HMAC_SECRET=your_qr_hmac_secret_here
QR_TOKEN_EXPIRY_SECONDS=30

# ─── Row-Level Security ───────────────────────────────────────────────────────
# PostgreSQL session variable name used by RLS policies
RLS_SESSION_VAR=app.company_id

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000
